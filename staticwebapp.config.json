{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/content/*.md", "/images/*", "*.js", "*.css", "*.svg", "*.ico", "*.png", "*.jpg"]
  },
  "routes": [
    {
      "route": "/content/*",
      "headers": {
        "Cache-Control": "no-cache",
        "Content-Type": "text/plain; charset=utf-8"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  },
  "globalHeaders": {
    "X-Frame-Options": "SAMEORIGIN",
    "X-Content-Type-Options": "nosniff",
    "X-XSS-Protection": "1; mode=block"
  }
}
